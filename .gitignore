# ── Dependencias y entornos ─────────────────────────────
node_modules/
.venv/
venv/
.npm-cache/
*.egg-info/

# ── Compilados y artefactos de build ────────────────────
dist/
build/
target/
*.tsbuildinfo
tsconfig.app.tsbuildinfo

# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest-tmp/
# Los .spec los genera PyInstaller desde engine/build_sidecar.py
*.spec

# ── Binarios / instaladores ─────────────────────────────
*.exe
*.msi
*.dll
*.so
*.dylib

# ── Sidecar compilado (se genera con build_sidecar.py) ──
app/src-tauri/binaries/*
!app/src-tauri/binaries/README.md
!app/src-tauri/binaries/.gitkeep

# ── Entorno y sistema ───────────────────────────────────
.env
.env.*
.DS_Store
Thumbs.db

# ── Archivos locales de prueba ──────────────────────────
Pruebas/
